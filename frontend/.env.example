# Copy to frontend/.env.local and fill in real values (Vite convention;
# already covered by the repo .gitignore's *.env.local / .env entries).
# Only the anon key -- it's subject to RLS (public read only). Never put the
# service-role key here, this bundle ships to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
