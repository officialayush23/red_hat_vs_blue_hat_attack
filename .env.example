# FraudShield — environment template. Copy to `.env` and fill in.
#
# `.env` is gitignored and must stay that way: SUPABASE_SERVICE_ROLE_KEY
# bypasses every RLS policy in backend/db/migrations/002_rls_policies.sql.
# Treat it like a database password, and rotate it from the Supabase
# dashboard if it is ever pasted into a screenshot, a log, or a chat.

# ---------------------------------------------------------------------------
# Supabase — backend (Python)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Public key. Read-only against the tables RLS exposes; safe in a browser.
SUPABASE_ANON_KEY=

# SECRET. Server-side only — writes attack_cases, evaluation_results,
# campaign_runs and model_registry. Never ship this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Model / generation credentials
# ---------------------------------------------------------------------------
# Hugging Face token — pulls the voice-spoof detector and Chatterbox TTS
# weights. A read-scoped token is enough.
HF_TOKEN=

# Optional. The LLM attack strategist. Principle 9: the system must fully
# function without this — leave it blank and mutation selection falls back
# to a deterministic rule-based selector rather than failing.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Evaluation routing (optional)
# ---------------------------------------------------------------------------
# Which OCR backend scores document_fraud: "rapidocr" (default, GPU-capable,
# winner of the bake-off) or "paddlevl". Setting "paddlevl" routes the step
# into backend/paddleocr_env, a separate interpreter, because the two
# dependency stacks cannot coexist.
DOC_OCR_BACKEND=rapidocr

# Set to 1 to require CUDA for OCR — raises instead of silently falling back
# to a slow CPU run that then gets reported as a fast one.
DOC_OCR_USE_GPU=0

# ---------------------------------------------------------------------------
# Frontend (Vite) — put these in frontend/.env, not here.
# Vite only exposes variables prefixed VITE_, and everything with that prefix
# is compiled into the public bundle. The anon key belongs here; the service
# role key never does.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=https://red-hat-vs-blue-hat-attack.onrender.com
