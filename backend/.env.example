# Copy to backend/.env and fill in real values. backend/.env is already
# gitignored -- this file documents the shape, never the values.

# Supabase project: RED_VS_BLUE_MASTERCARD (ap-south-1)
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS -- backend-only, NEVER expose to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -- only needed if a script talks to Postgres
# directly (psycopg2/asyncpg) instead of through the supabase-py client.
SUPABASE_PASSWORD=
TRANSACTION_POOLER_URL=
DIRECT_CONNNECTION_URL=

# Kaggle (backend/identify dataset download)
KAGGLE_API_TOKEN=

# Phase 4 -- LLM strategist (/api/strategize). Empty is fine: Principle 9
# requires the system to work with this disabled, and it degrades to a
# rule-based mutation selector when unset.
GEMINI_API_KEY=
GROK_API_KEY=

# Phase 2.5 research spike -- only needed if a HF gated/private checkpoint
# is used instead of a public one.
HF_TOKEN=
